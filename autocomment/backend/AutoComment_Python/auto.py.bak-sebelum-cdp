    print(f"  👤 Akun    : {len(accounts_to_run)} akun")
    for acc in accounts_to_run:
        print(f"             - {acc['name']} ({acc['email']})")
    print("="*55)

    confirm = input("\n  Mulai komentar? (y/n) : ").strip().lower()
    if confirm != "y":
        print("\n⛔ Dibatalkan.\n")
        return

    url     = _state["post_url"]
    results = load_results()

    for idx, account in enumerate(accounts_to_run, 1):
        name         = account["name"]
        email        = account["email"]
        cookies_path = account["cookies_path"]

        print()
        log.info(f"{'='*50}")
        log.info(f"👤 Akun {idx}/{len(accounts_to_run)}: {name} ({email})")
        log.info(f"{'='*50}")

        driver = None
        try:
            driver = build_driver(headless=False)

            # Inject cookies
            log.info(f"🍪 Load cookies dari: {cookies_path.name}")
            driver.get("https://www.facebook.com")
            time.sleep(2)

            with open(cookies_path, encoding="utf-8") as f:
                cookies = json.load(f)

            for cookie in cookies:
                clean = {
                    "name":   cookie["name"],
                    "value":  cookie["value"],
                    "domain": cookie.get("domain", ".facebook.com"),
                    "path":   cookie.get("path", "/"),
                    "secure": cookie.get("secure", True),
                }
                if "expirationDate" in cookie:
                    clean["expiry"] = int(cookie["expirationDate"])
                try:
                    driver.add_cookie(clean)
                except Exception:
                    pass

            # Cek login
            driver.get("https://www.facebook.com")
            time.sleep(3)

            is_login_page = "facebook.com/login" in driver.current_url.lower()
            if not is_login_page:
                try:
                    driver.find_element(By.CSS_SELECTOR, "input#email[name='email']")
                    is_login_page = True
                except NoSuchElementException:
                    pass

            if is_login_page:
                log.error(f"❌ Cookies {name} expired/invalid")
                results.append({
                    "account": name, "email": email, "post_url": url,
                    "success": False, "error": "Cookies expired",
                    "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                })
                save_results(results)
                continue

            log.info(f"✅ Login berhasil sebagai {name}")

            post_text = get_post_text(driver, url)
            comment   = generate_comment(post_text)
            success   = submit_comment(driver, comment)

            results.append({
                "account":   name,
                "email":     email,
                "post_url":  url,
                "comment":   comment,
                "success":   success,
                "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            })
            save_results(results)

            if success:
                log.info(f"✅ Komentar berhasil dikirim: {comment}")
            else:
                log.warning(f"⚠️  Komentar gagal dikirim")

        except Exception as e:
            log.error(f"❌ Error: {e}")
            results.append({
                "account": name, "email": email, "post_url": url,
                "success": False, "error": str(e),
                "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            })
            save_results(results)
        finally:
            if driver:
                try:
                    driver.quit()
                except Exception:
                    pass
            log.info(f"🔒 Browser {name} ditutup")

        if idx < len(accounts_to_run):
            delay = random.uniform(8, 15)
            log.info(f"⏳ Jeda {delay:.1f} detik sebelum akun berikutnya...")
            time.sleep(delay)

    log.info(f"\n🏁 Selesai! Hasil tersimpan di: {RESULTS_FILE}")


