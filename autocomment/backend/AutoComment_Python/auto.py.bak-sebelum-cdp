def load_accounts() -> list[dict]:
    # ── FIX: handle file tidak ada / kosong tanpa crash ──
    if not ACCOUNTS_FILE.exists():
        log.error(f"❌ File akun tidak ditemukan: {ACCOUNTS_FILE}")
        log.error("   Buat file accounts/accounts.json dulu dengan format:")
        log.error('   [{"name": "akun1", "email": "a@b.com", "password": "xxx"}]')
        return []
    try:
        with open(ACCOUNTS_FILE, encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, list):
            log.error("❌ Format accounts.json harus list/array JSON")
            return []
        return data
    except json.JSONDecodeError as e:
        log.error(f"❌ accounts.json bukan JSON valid: {e}")
        return []


def load_results() -> list[dict]:
    if RESULTS_FILE.exists():
        try:
            with open(RESULTS_FILE, encoding="utf-8") as f:
                return json.load(f)
        except json.JSONDecodeError:
            return []
    return []


def save_results(results: list[dict]) -> None:
    with open(RESULTS_FILE, "w", encoding="utf-8") as f:
        json.dump(results, f, indent=2, ensure_ascii=False)


def build_driver(headless: bool = False) -> webdriver.Chrome:
    """Buat Chrome driver dengan opsi anti-deteksi dasar."""
    opts = Options()
    if headless:
        opts.add_argument("--headless=new")
    opts.add_argument("--no-sandbox")
    opts.add_argument("--disable-dev-shm-usage")
    opts.add_argument("--disable-blink-features=AutomationControlled")
    opts.add_experimental_option("excludeSwitches", ["enable-automation"])
    opts.add_experimental_option("useAutomationExtension", False)
    opts.add_argument("--window-size=1280,800")
    opts.add_argument(
        "user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/152.0.0.0 Safari/537.36"
    )

    service = Service(ChromeDriverManager().install())
    driver = webdriver.Chrome(service=service, options=opts)

    # Sembunyikan navigator.webdriver
    driver.execute_cdp_cmd(
        "Page.addScriptToEvaluateOnNewDocument",
        {"source": "Object.defineProperty(navigator, 'webdriver', {get: () => undefined})"},
    )
    return driver


def inject_cookies(driver: webdriver.Chrome, account_name: str) -> bool:
    """Load cookies dari file ke browser."""
    cookie_file = COOKIES_DIR / f"{account_name}_cookies.json"
    if not cookie_file.exists():
        log.warning(f"File cookies tidak ditemukan: {cookie_file}")
        return False

    try:
        with open(cookie_file, encoding="utf-8") as f:
            cookies = json.load(f)
    except json.JSONDecodeError as e:
        log.error(f"❌ File cookies bukan JSON valid: {e}")
        return False

    if not isinstance(cookies, list) or not cookies:
        log.error(f"❌ Cookies kosong atau format salah untuk {account_name}")
        return False

    # Buka facebook.com dulu sebelum inject cookies
    driver.get("https://www.facebook.com")
    time.sleep(2)

    injected = 0
    for cookie in cookies:
        clean = {
            "name":   cookie.get("name"),
            "value":  cookie.get("value"),
            "domain": cookie.get("domain", ".facebook.com"),
            "path":   cookie.get("path", "/"),
            "secure": cookie.get("secure", True),
        }
        if not clean["name"] or not clean["value"]:
            continue
        if "expirationDate" in cookie:
            try:
                clean["expiry"] = int(cookie["expirationDate"])
            except (ValueError, TypeError):
                pass
        try:
            driver.add_cookie(clean)
            injected += 1
        except Exception as e:
            log.debug(f"Skip cookie '{cookie.get('name')}': {e}")

    log.info(f"✅ {injected} cookies {account_name} berhasil di-inject")
    return injected > 0


def get_post_text(driver: webdriver.Chrome, post_url: str) -> str:
    """Ambil teks dari postingan Facebook."""
    driver.get(post_url)
    time.sleep(4)

    # Coba pakai JavaScript untuk ambil teks dari elemen post utama.
    # Strategi: cari article pertama di halaman (itu adalah post yang dituju),
    # lalu ambil semua teks di dalamnya yang bukan komentar/reaksi.
    try:
        text = driver.execute_script("""
            // Cari article pertama = post utama
            const articles = document.querySelectorAll('div[role="article"]');
            if (!articles.length) return null;

            const article = articles[0];

            // Cari elemen teks postingan — prioritaskan data-ad-preview atau data-testid
            const msgSelectors = [
                '[data-ad-preview="message"]',
                '[data-ad-comet-preview="message"]',
                '[data-testid="post_message"]',
            ];
            for (const sel of msgSelectors) {
                const el = article.querySelector(sel);
                if (el && el.innerText.trim().length > 5) {
                    return el.innerText.trim();
                }
            }

            // Fallback: ambil semua div[dir="auto"] langsung di dalam article,
            // tapi HANYA yang berada di kedalaman dangkal (bukan komentar di bawah)
            const dirAutos = article.querySelectorAll(':scope > div div[dir="auto"]');
            for (const el of dirAutos) {
                const t = el.innerText.trim();
                // Ambil yang cukup panjang dan bukan nama/label pendek
                if (t.length > 20) return t;
            }

            return null;
        """)

        if text and len(text.strip()) > 5:
            log.info(f"📄 Teks post ({len(text)} char): {text[:100]}...")
            return text.strip()
    except Exception as e:
        log.debug(f"JS extract gagal: {e}")

    # Fallback: judul halaman
    title = driver.title.replace(" | Facebook", "").strip()
    if title and len(title) > 5:
        log.warning(f"⚠️  Pakai title sebagai fallback: {title}")
        return title

    log.warning("⚠️  Tidak bisa baca teks post, pakai placeholder")
    return "Postingan Facebook"


def submit_comment(driver: webdriver.Chrome, comment_text: str) -> bool:
    """Klik kotak komentar dan submit."""
    wait = WebDriverWait(driver, 15)

    # Scroll ke bawah supaya comment box muncul
    driver.execute_script("window.scrollBy(0, 600)")
    time.sleep(1)

    # ── FIX: selector lebih lengkap, termasuk versi dengan "..." (tiga titik) ──
    comment_box_selectors = [
        "div[aria-label='Write a comment…']",
        "div[aria-label='Write a comment...']",
        "div[aria-label='Write a comment']",
        "div[aria-label='Tulis komentar…']",
        "div[aria-label='Tulis komentar...']",
        "div[aria-label='Tulis komentar']",
        "div[contenteditable='true'][role='textbox']",
    ]

    comment_box = None
    for sel in comment_box_selectors:
        try:
            comment_box = wait.until(EC.element_to_be_clickable((By.CSS_SELECTOR, sel)))
            log.info(f"✅ Ketemu kotak komentar: {sel}")
            break
        except TimeoutException:
            continue

    if not comment_box:
        log.error("❌ Kotak komentar tidak ditemukan")
        driver.save_screenshot("debug_no_comment_box.png")
        return False

    # Klik dan ketik komentar
    try:
        comment_box.click()
        time.sleep(random.uniform(0.5, 1.2))

        # Ketik karakter per karakter
        for char in comment_text:
            comment_box.send_keys(char)
            time.sleep(random.uniform(0.02, 0.07))

        time.sleep(random.uniform(0.8, 1.5))
    except Exception as e:
        log.error(f"❌ Gagal ketik komentar: {e}")
        return False

    # ── FIX: coba Enter dulu, kalau gagal coba klik tombol kirim ──
    try:
        comment_box.send_keys(Keys.RETURN)
        time.sleep(2)
    except Exception:
        pass

    # Cek apakah komentar masih ada di kotak (berarti Enter gagal)
    try:
        still_there = comment_box.text.strip() if comment_box else ""
        if still_there:
            log.info("ℹ️  Enter tidak submit, coba klik tombol Post...")
            # Cari tombol Post di sekitar kotak komentar
            post_btn_selectors = [
                "div[aria-label='Post'][role='button']",
                "div[aria-label='Posting'][role='button']",
                "div[aria-label='Kirim'][role='button']",
                "div[role='button'][tabindex='0'] span:contains('Post')",
            ]
            for btn_sel in post_btn_selectors:
                try:
                    btn = driver.find_element(By.CSS_SELECTOR, btn_sel)
                    btn.click()
                    time.sleep(2)
                    break
                except Exception:
                    continue
    except Exception:
        pass

    log.info(f"💬 Komentar dikirim: {comment_text}")
    return True


# ── Main flow ──────────────────────────────────────────────────────────────────
def run_autocomment(post_urls: list[str], headless: bool = False) -> None:
    if not post_urls:
        log.error("❌ Tidak ada URL post yang diisi. Set FB_POST_URLS di .env atau edit auto.py")
        return

    accounts = load_accounts()
    if not accounts:
        log.error("❌ Tidak ada akun yang bisa diproses. Berhenti.")
        return

    results = load_results()

    log.info(f"🚀 Mulai proses: {len(accounts)} akun × {len(post_urls)} post")

    for idx, account in enumerate(accounts, 1):
        name  = account.get("name", "unknown")
        email = account.get("email", "")
        log.info(f"\n{'='*50}")
        log.info(f"👤 Akun {idx}/{len(accounts)}: {name} ({email})")
        log.info(f"{'='*50}")

        driver = None  # ── FIX: init dulu supaya aman di finally ──
        try:
            driver = build_driver(headless=headless)

            # Inject cookies
            if not inject_cookies(driver, name):
                log.error(f"❌ Gagal load cookies untuk {name}, skip akun ini")
                results.append({
                    "account": name,
                    "email": email,
                    "success": False,
                    "error": "Cookies tidak ditemukan/invalid",
                    "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                })
                save_results(results)
                continue

            # Refresh setelah inject cookies untuk verifikasi login
            driver.get("https://www.facebook.com")
            time.sleep(3)

            # ── FIX: cek login dengan indikator lebih akurat ──
            current_url = driver.current_url.lower()
            is_login_page = (
                "login" in current_url
                and "facebook.com/login" in current_url
            ) or "/recover" in current_url

            # Cek juga apakah form login terlihat
            if not is_login_page:
                try:
                    driver.find_element(By.CSS_SELECTOR, "input#email[name='email']")
                    is_login_page = True
                except NoSuchElementException:
                    pass

            if is_login_page:
                log.error(f"❌ Cookies {name} expired/invalid, tidak bisa login")
                results.append({
                    "account": name,
                    "email": email,
                    "success": False,
                    "error": "Cookies expired",
                    "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                })
                save_results(results)
                continue

            log.info(f"✅ Login berhasil sebagai {name}")

            # Proses setiap post URL
            for url in post_urls:
                log.info(f"\n🔗 Post: {url}")
                try:
                    post_text = get_post_text(driver, url)
                    comment   = generate_comment(post_text)

                    success = submit_comment(driver, comment)

                    results.append({
                        "account":   name,
                        "email":     email,
                        "post_url":  url,
                        "comment":   comment,
                        "success":   success,
                        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                    })
                    save_results(results)

                    if success:
                        log.info(f"✅ Selesai komentar di: {url}")
                    else:
                        log.warning(f"⚠️  Gagal submit komentar di: {url}")

                except Exception as e:
                    log.error(f"❌ Error di {url}: {e}")
                    results.append({
                        "account":   name,
                        "email":     email,
                        "post_url":  url,
                        "success":   False,
                        "error":     str(e),
                        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                    })
                    save_results(results)

                # Jeda antar post
                if len(post_urls) > 1:
                    delay = random.uniform(5, 12)
                    log.info(f"⏳ Jeda {delay:.1f} detik...")
                    time.sleep(delay)

        except Exception as e:
            log.error(f"❌ Error tak terduga untuk akun {name}: {e}")
        finally:
            # ── FIX: cek driver None dulu ──
            if driver:
                try:
                    driver.quit()
                except Exception:
                    pass
                log.info(f"🔒 Browser {name} ditutup")

        # Jeda antar akun
        if idx < len(accounts):
            delay = random.uniform(8, 15)
            log.info(f"⏳ Jeda {delay:.1f} detik sebelum akun berikutnya...")
            time.sleep(delay)

    log.info(f"\n{'='*50}")
    log.info("🏁 Semua akun selesai diproses")
    log.info(f"📄 Hasil tersimpan di: {RESULTS_FILE}")


def prompt_input(label: str, required: bool = True, secret: bool = False) -> str:
    """Input helper dengan validasi tidak boleh kosong."""
    import getpass
    while True:
        try:
            value = (getpass.getpass(f"  {label} : ") if secret
                     else input(f"  {label} : ").strip())
        except (EOFError, KeyboardInterrupt):
            return ""
        if value:
            return value
        if not required:
            return ""
        print("  ⚠️  Tidak boleh kosong, coba lagi.\n")


